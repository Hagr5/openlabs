# DuckMarket local environment.
# Copy to .env and adjust before starting the stack.

# Session signing key (use a long random value outside local development).
SESSION_SECRET=please-change-me-to-a-long-random-string

# Shared key used between the platform and the managed function runtime
# (internal service-to-service requests only).
FUNCTION_RUNTIME_SHARED_KEY=please-change-me-too

# Secret applied to the managed function runtime environment at startup.
FLAG=DUCK{replace-with-your-own-value}
