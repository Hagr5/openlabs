# TechVault (Challenge 2 — GraphQL) — environment variables
# Copy this file to .env and adjust as needed before running
# `docker compose up --build`.

# Port exposed to the host for the player-facing GraphQL API.
TECHVAULT_PORT=4000

# The challenge flag. Read by billing-core (the internal service) via
# env-var-first resolution (see billing-core/src/data.js). In the deployed
# lab this value is injected by the platform at deploy time — never commit
# a real flag to this file.
FLAG=duck{REPLACE_ME_BEFORE_RUNNING}
