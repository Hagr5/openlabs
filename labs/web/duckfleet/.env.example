# Copy this file to .env and adjust before starting the lab:
#   cp .env.example .env
#
# The value below is a placeholder. Set FLAG to the secret string you want
# players to recover (format DUCK{...}).

FLAG=DUCK{replace-this-with-your-own-secret-before-playing}

# Optional. When left empty, the backend generates a strong random session
# secret on first boot and stores it in the data volume. Set an explicit
# value only if you need stable sessions across full resets.
SESSION_SECRET=
