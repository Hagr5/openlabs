# firmdrama local configuration.
FIRMDRAMA_ENVIRONMENT=development
FIRMDRAMA_HOST=0.0.0.0
# Internal development-server port; Docker publishes http://127.0.0.1:8080.
FIRMDRAMA_PORT=8000
FIRMDRAMA_LOG_LEVEL=info
FIRMDRAMA_DATABASE_REQUIRED=true
FIRMDRAMA_DB_HOST=127.0.0.1
FIRMDRAMA_DB_PORT=3306
FIRMDRAMA_DB_NAME=firmdrama
FIRMDRAMA_DB_USER=firmdrama
FIRMDRAMA_DB_PASSWORD=firmdrama-local-only
# Comma-separated public host names. Use your TLS hostname when hosted.
FIRMDRAMA_TRUSTED_HOSTS=localhost,127.0.0.1,firmdrama
# Set true when the public endpoint is served over HTTPS.
FIRMDRAMA_COOKIE_SECURE=false
FIRMDRAMA_MAX_CONTENT_LENGTH=65536
