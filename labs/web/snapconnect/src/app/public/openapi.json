{
  "openapi": "3.1.0",
  "info": {
    "title": "SnapConnect API",
    "version": "2.0.0",
    "description": "Public reference for the SnapConnect member API.\n\nThe API is GraphQL. Send operation documents to `POST /graphql` as JSON with optional `variables`. The schema supports full introspection, so point a GraphQL client at the endpoint to explore everything the API offers.\n\nOperations that act on behalf of a member require a bearer token in the `Authorization` header.",
    "contact": {
      "name": "SnapConnect engineering",
      "email": "api@snapconnect.dev"
    }
  },
  "servers": [
    { "url": "/", "description": "SnapConnect" }
  ],
  "paths": {
    "/graphql": {
      "post": {
        "summary": "GraphQL endpoint",
        "description": "Execute a query, mutation, or introspection document.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GraphqlRequest" },
              "examples": {
                "ping": {
                  "summary": "Ping the service",
                  "value": { "query": "{ serverVersion }" }
                },
                "introspect": {
                  "summary": "Introspect the schema",
                  "value": { "query": "{ __schema { queryType { name } mutationType { name } } }" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GraphQL envelope. Field and resolver failures return `errors` alongside partial or null `data`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GraphqlResponse" },
                "examples": {
                  "success": { "value": { "data": { "serverVersion": "2.0.0" } } },
                  "error": { "value": { "errors": [{ "message": "Authentication required." }] } }
                }
              }
            }
          },
          "400": { "description": "Malformed request body." }
        }
      }
    },
    "/uploads/{filename}": {
      "get": {
        "summary": "Stored file",
        "description": "Files stored by the service are served from this path.",
        "parameters": [
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "File bytes." },
          "404": { "description": "No such file." }
        }
      }
    },
    "/health.php": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service healthy.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" },
                "example": { "status": "ok", "service": "snapconnect-api", "version": "2.0.0" }
              }
            }
          },
          "503": { "description": "Degraded." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Session token. Send as `Authorization: Bearer <token>`."
      }
    },
    "schemas": {
      "GraphqlRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "description": "GraphQL document." },
          "variables": { "type": "object", "description": "Variable values for the document." },
          "operationName": { "type": "string", "description": "Operation to execute when the document has several." }
        }
      },
      "GraphqlResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "object", "nullable": true },
          "errors": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": { "message": { "type": "string" } }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded"] },
          "service": { "type": "string" },
          "version": { "type": "string" },
          "checks": { "type": "object" }
        }
      }
    }
  }
}
